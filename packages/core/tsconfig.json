{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    // noUncheckedIndexedAccess was enabled in M1, then relaxed in M2
    // after core started depending on @celestia/astrology. Astrology's
    // source contains several possibly-undefined sites its own looser
    // tsconfig allows, and TypeScript cross-package typechecking walks
    // into astrology's .ts source (no built .d.ts exists). Turning this
    // flag on in core cascaded ~10 unrelated errors in astrology that
    // were out of M2 scope. Re-enable when astrology tightens its own
    // config — tracked in a future phase. Helpers in src/lib/invariant.ts
    // (first, last, at) remain available as convention for core code
    // that genuinely needs bounded-access throws.
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
