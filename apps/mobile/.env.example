# Clerk authentication (mobile)
# Reuse the same publishable key as apps/web (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Same Clerk application; only the env-var name differs per Expo convention.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Supabase (mobile)
# Reuse the same URL + anon key as apps/web. The anon key is safe to expose
# client-side; RLS policies enforce per-user access via the Clerk-issued JWT.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# RevenueCat (mobile, P.15/REVISIT-25). Platform-specific public API keys
# from the RevenueCat dashboard (Project Settings > API Keys) — NOT the
# same key on both platforms. RevenueCatProvider deliberately checks for
# the "REPLACE_WITH_" prefix and logs loudly (not silently) if it's still
# present, so a forgotten real key doesn't pass unnoticed. Values below
# are intentionally invalid placeholders, not real-looking test keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=REPLACE_WITH_REVENUECAT_IOS_API_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=REPLACE_WITH_REVENUECAT_ANDROID_API_KEY
