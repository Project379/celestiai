# Clerk authentication (mobile)
# Reuse the same publishable key as apps/web (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).
# Same Clerk application; only the env-var name differs per Expo convention.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxx

# Mobile never talks to Supabase directly — no @supabase/supabase-js usage
# anywhere in apps/mobile. All data access goes through apps/web's API
# routes via lib/api/client.ts. Do not add Supabase env vars here; a prior
# .env.local carried NEXT_PUBLIC_SUPABASE_URL/_ANON_KEY (the web app's
# naming, copy-pasted in) implying a direct connection that doesn't exist.

# apps/web's base URL, used by lib/api/client.ts for every request. Missing
# throws an explicit "Missing EXPO_PUBLIC_API_BASE env var" error (see that
# file) rather than failing silently. Until a production deploy exists, this
# is your dev machine's LAN IP with `pnpm --filter web dev` running, e.g.
# http://192.168.1.4:3000 — testing-only, not a value to ship in a real
# release build.
EXPO_PUBLIC_API_BASE=http://192.168.1.4:3000

# Sentry (mobile). Same DSN as web's Sentry project — apps/web's env var is
# named NEXT_PUBLIC_SENTRY_DSN; mobile's Expo convention is EXPO_PUBLIC_.
# These are NOT interchangeable — lib/monitoring/sentry.ts reads exactly
# this name and no-ops cleanly (by design) when unset, so a value under the
# wrong name produces no error, just silently zero crash reporting. Verify
# after setting: sentry.ts's DSN check is `if (dsn)`, so an empty/missing
# value here is indistinguishable from "no error" until you check a live
# Sentry dashboard for an event.
EXPO_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxx.ingest.de.sentry.io/xxxxxxx

# RevenueCat (mobile, P.15/REVISIT-25). Platform-specific public API keys
# from the RevenueCat dashboard (Project Settings > API Keys) — NOT the
# same key on both platforms. RevenueCatProvider deliberately checks for
# the "REPLACE_WITH_" prefix and logs loudly (not silently) if it's still
# present, so a forgotten real key doesn't pass unnoticed. Values below
# are intentionally invalid placeholders, not real-looking test keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=REPLACE_WITH_REVENUECAT_IOS_API_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=REPLACE_WITH_REVENUECAT_ANDROID_API_KEY

# Web app URL (Batch 5, /you/premium free-state CTA). The free-tier
# "subscribe" action has no native purchase flow yet (RevenueCat paywall UI
# is halt-required, not built) — it points users at the web app's /pricing
# page instead. NOT set to a real value yet: web has no confirmed live
# deployment as of 2026-08-14 (every Vercel deploy has failed since project
# creation). getWebAppUrl() (lib/config/webAppUrl.ts) checks for this exact
# "REPLACE_WITH_" prefix and logs loudly + hides the CTA entirely rather
# than rendering a dead link — same pattern as the RevenueCat keys below.
# Set to the real domain once Vercel deploys successfully (founder-owned).
EXPO_PUBLIC_WEB_APP_URL=REPLACE_WITH_WEB_APP_URL

# PostHog (EU ingest — same project/key as apps/web, see lib/analytics/
# posthog.ts). Configured cookieless (persistence: 'memory') and with
# captureAppLifecycleEvents/session replay/surveys/remote feature flags
# all off — see that file's header comment before changing any option.
EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Feature flags (optional). All three default to enabled when unset
# (checked as `!== 'false'` in hooks/useFeatureFlag.ts) — only set one to
# 'false' to explicitly disable that feature; omitting them entirely is
# the normal, supported state.
# EXPO_PUBLIC_FF_DAILY_HOROSCOPE=false
# EXPO_PUBLIC_FF_ORACLE=false
# EXPO_PUBLIC_FF_PUSH=false
