{
  "expo": {
    "name": "Stellaeum",
    "slug": "stellaeum",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "stellaeum",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stellaeum.app"
    },
    "android": {
      "package": "com.stellaeum.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08060f"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbb9b3d2-01b3-4471-a2fd-e3262a7bf107"
      }
    }
  }
}
