{
  "expo": {
    "name": "Stellaeum",
    "slug": "stellaeum",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "stellaeum",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stellaeum.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.stellaeum.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08060f",
          "image": "./assets/splash.png"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-font",
      "./plugins/withEmulatorLoopbackCleartext",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 30,
            "packagingOptions": {
              "exclude": ["META-INF/versions/9/OSGI-INF/MANIFEST.MF"]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbb9b3d2-01b3-4471-a2fd-e3262a7bf107"
      }
    }
  }
}
