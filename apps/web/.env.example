# Clerk Authentication (from Clerk Dashboard > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Auth URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase (from Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (from Supabase Dashboard > Project Settings > Database > Connection string URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase service role key (Project Settings > API > service_role). Server-only,
# bypasses RLS — used by lib/supabase/service.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenRouter (AI generation — daily horoscope, Oracle). From openrouter.ai > Keys.
# Read directly as OPENROUTER_API_KEY in lib/ai/client.ts — do not rename without
# updating that file (see .planning/research/AI_PROVIDER_DECISION.md §3.2 for
# the naming-collision history — .env.local previously stored this key under
# OPENAI_API_KEY, and @ai-sdk/openai's loadApiKey silently fell back to it).
OPENROUTER_API_KEY=sk-or-v1-...

# Cron endpoint auth (Vercel Cron > this project's scheduled functions send this
# as a bearer/secret header). Any random secret string.
CRON_SECRET=your-cron-secret

# Web Push VAPID keys (push notifications). Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Stripe (Phase 7 — from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard > Developers > Webhooks > Signing secret (created in 07-02)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Dashboard > Products > Stellaeum Premium > Monthly price ID
STRIPE_PRICE_MONTHLY=price_xxx
# Stripe Dashboard > Products > Stellaeum Premium > Annual price ID
STRIPE_PRICE_ANNUAL=price_xxx

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry Error Monitoring (PRE_LAUNCH_PREREQS.md item 2)
# Create org+project at https://sentry.io (EU region recommended for GDPR data-residency).
# Same DSN value goes in both NEXT_PUBLIC_SENTRY_DSN (client bundle) and SENTRY_DSN (server/edge).
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0000000.ingest.de.sentry.io/0000000
SENTRY_DSN=https://your-public-key@o0000000.ingest.de.sentry.io/0000000
# Auth token scopes: project:releases + org:read (sentry.io > Settings > Auth Tokens). Build-time only.
SENTRY_AUTH_TOKEN=sntrys_eyJ...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# PostHog (analytics — signup, birth data, chart view, free Oracle, subscription
# events). EU ingest host, not US — see .planning/SYSTEM-MAP.md §12. The client
# is configured cookieless (memory persistence) so this needs no consent banner;
# do not change persistence in components/analytics/PostHogProvider.tsx without
# re-closing COOKIE-CONSENT in .planning/PLACEHOLDERS.md.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# RevenueCat webhook signing secret (REVISIT-62). RevenueCat Dashboard >
# Project Settings > Webhooks > your webhook integration > toggle HMAC
# signing on > copy the signing secret (shown once, at creation/rotation).
# The webhook route fails closed if this is unset — never falls back to
# skipping signature verification.
REVENUECAT_WEBHOOK_SECRET=REPLACE_WITH_REVENUECAT_WEBHOOK_SIGNING_SECRET
