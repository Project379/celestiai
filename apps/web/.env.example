# Clerk Authentication (from Clerk Dashboard > API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Auth URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Supabase (from Supabase Dashboard > Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...), the new-format replacement for the
# legacy anon key. MUST keep the NEXT_PUBLIC_ prefix — lib/supabase/client.ts
# runs client-side and Next.js only inlines NEXT_PUBLIC_* into the browser
# bundle; without the prefix the browser client gets undefined.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Database (from Supabase Dashboard > Project Settings > Database > Connection string URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase secret key (sb_secret_...), the new-format replacement for the
# legacy service_role key — same privilege level (Project Settings > API Keys >
# Secret keys). Server-only, bypasses RLS — used by lib/supabase/service.ts and
# packages/core/src/lib/supabase.ts.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Gemini (AI generation — daily horoscope, Oracle). From Google AI Studio
# > API keys. Read directly as GEMINI_API_KEY in lib/ai/client.ts — do not rename
# without updating that file (see .planning/research/AI_PROVIDER_DECISION.md §3.2
# for the naming-collision history — .env.local previously stored an AI key under
# OPENAI_API_KEY, and @ai-sdk/openai's loadApiKey silently fell back to it).
GEMINI_API_KEY=...

# Cron endpoint auth (Vercel Cron > this project's scheduled functions send this
# as a bearer/secret header). Any random secret string.
CRON_SECRET=your-cron-secret

# Post-deploy smoke probe auth (GET /api/smoke — see scripts/smoke.mjs and
# .github/workflows/smoke.yml). Bearer secret, same shape as CRON_SECRET.
# Read only inside the /api/smoke request handler, so it is a turbo.json
# globalPassThroughEnv entry, not a build input.
SMOKE_SECRET=your-smoke-secret

# Web Push VAPID keys (push notifications). Generate with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Stripe (Phase 7 — from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe Dashboard > Developers > Webhooks > Signing secret (created in 07-02)
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Stripe Dashboard > Products > Stellaeum Premium > Monthly price ID
STRIPE_PRICE_MONTHLY=price_xxx
# Stripe Dashboard > Products > Stellaeum Premium > Annual price ID
STRIPE_PRICE_ANNUAL=price_xxx

# App URL (used for Stripe redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry Error Monitoring (PRE_LAUNCH_PREREQS.md item 2)
# Create org+project at https://sentry.io (EU region recommended for GDPR data-residency).
# Same DSN value goes in both NEXT_PUBLIC_SENTRY_DSN (client bundle) and SENTRY_DSN (server/edge).
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@o0000000.ingest.de.sentry.io/0000000
SENTRY_DSN=https://your-public-key@o0000000.ingest.de.sentry.io/0000000
# Auth token scopes: project:releases + org:read (sentry.io > Settings > Auth Tokens). Build-time only.
SENTRY_AUTH_TOKEN=sntrys_eyJ...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# PostHog (analytics — signup, birth data, chart view, free Oracle, subscription
# events). EU ingest host, not US — see .planning/SYSTEM-MAP.md §12. The client
# is configured cookieless (memory persistence) so this needs no consent banner;
# do not change persistence in components/analytics/PostHogProvider.tsx without
# re-closing COOKIE-CONSENT in .planning/PLACEHOLDERS.md.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# RevenueCat webhook signing secret (REVISIT-62). RevenueCat Dashboard >
# Project Settings > Webhooks > your webhook integration > toggle HMAC
# signing on > copy the signing secret (shown once, at creation/rotation).
# The webhook route fails closed if this is unset — never falls back to
# skipping signature verification.
REVENUECAT_WEBHOOK_SECRET=REPLACE_WITH_REVENUECAT_WEBHOOK_SIGNING_SECRET

# Movie/book recommendations. Development mode allows only catalog rows and
# assets explicitly marked development/both. Production defaults to commercial
# when this variable is omitted, so development-only provider images fail shut.
# Read by packages/core/src/recommendations/{service.ts,import.ts}; not a build
# input — see turbo.json globalPassThroughEnv.
RECOMMENDATION_RIGHTS_MODE=development

# TMDB API read access token, used only by the bounded monthly development
# catalog import. Imported candidates remain draft + review_required. Optional:
# if unset, the TMDB import is skipped and OpenLibrary still runs (no crash).
# themoviedb.org > Settings > API > "API Read Access Token" (the v4 bearer).
TMDB_API_READ_TOKEN=
